package render

CHAR_SIZE :: Vec2{3, 5}
SPACE_SIZE :: 1

Vec2 :: [2]int
Char_Pixels :: [CHAR_SIZE.y][CHAR_SIZE.x]u8

draw_text :: proc(text: string, pos: Vec2) {
	FONT_SIZE :: 1
	dx := 0
	p0 := pos * TILE_SIZE

	for c in text {
		pixels := font_data[c]
		for y in 0 ..< CHAR_SIZE.y {
			for x in 0 ..< CHAR_SIZE.x {
				if pixels[y][x] == 0 do continue
				draw_pixel(p0 + {dx + x, y}, .WHITE)
			}
		}
		dx += CHAR_SIZE.x + SPACE_SIZE
	}
}

